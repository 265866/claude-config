{
  "cleanupPeriodDays": 36500,
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "3600000",
    "ANTHROPIC_BASE_URL": "http://moss:8317",
    "ANTHROPIC_AUTH_TOKEN": "(\\__/) (='.'=) (\")_(\") bunny guards this fake key",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "API_TIMEOUT_MS": "600000",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "MCP_TIMEOUT": "30000",
    "MCP_TOOL_TIMEOUT": "600000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90",
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-5-5",
  "disableClaudeAiConnectors": true,
  "enableWorkflows": true,
  "maxEffortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(curl *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "curl"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(wget *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "wget"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(curl *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "curl"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(wget *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "wget"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(Invoke-WebRequest *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "iwr"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(Invoke-RestMethod *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "irm"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(curl *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "curl"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(wget *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "wget"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(curl *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "curl"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(wget *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "wget"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(Invoke-WebRequest *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "iwr"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "PowerShell(Invoke-RestMethod *)",
            "command": "bun",
            "args": [
              "--no-env-file",
              "-e",
              "await import((process.env.CLAUDE_CONFIG_DIR || require(\"node:os\").homedir() + \"/.claude\") + \"/hooks/blocked-fetch.ts\")",
              "irm"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
